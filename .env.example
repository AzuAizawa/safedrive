# SafeDrive browser-safe configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_PAYMONGO_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY
# Optional. Cloudflare Turnstile site key for the login/sign-up captcha.
# Leave blank to keep captcha off. When set, also enable captcha protection in
# Supabase Auth settings and add the matching secret there - both together.
VITE_TURNSTILE_SITE_KEY=

# Server-only Supabase and PayMongo configuration
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional modern Supabase server secret; the APIs accept this instead of the legacy service-role key.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET
PAYMONGO_SECRET_KEY=sk_test_YOUR_SECRET_KEY
PAYMONGO_WEBHOOK_SECRET=YOUR_PAYMONGO_WEBHOOK_SECRET
PAYMONGO_PAYOUT_WALLET_ID=YOUR_PAYMONGO_WALLET_ID
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# Transactional email through Resend. Use a verified Resend sending domain;
# never prefix these names with VITE_. RESEND_REPLY_TO is optional.
RESEND_API_KEY=re_YOUR_RESEND_SERVER_KEY
RESEND_FROM_EMAIL=SafeDrive <receipts@YOUR_VERIFIED_DOMAIN>
RESEND_REPLY_TO=support@YOUR_VERIFIED_DOMAIN

# SafeDrive-generated server secrets (use independent random values)
CRON_SECRET=GENERATE_A_RANDOM_64_CHARACTER_HEX_VALUE
GUEST_INQUIRY_HASH_SALT=GENERATE_A_DIFFERENT_RANDOM_64_CHARACTER_HEX_VALUE
GMAIL_WEBHOOK_SHARED_SECRET=GENERATE_A_DIFFERENT_RANDOM_64_CHARACTER_HEX_VALUE

# Legacy Google Apps Script fallback URLs (must end in /exec). Guest replies and
# return reminders use these only when Resend is not configured.
GMAIL_GUEST_INQUIRY_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GMAIL_RETURN_REMINDER_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Local/test-only switch. Keep false or omit in every public deployment.
PAYMONGO_ENABLE_SANDBOX_PAYOUT_COMPLETION=false
