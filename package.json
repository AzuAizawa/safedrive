{
  "name": "safedrive-2-0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "vite --force",
    "clean": "node scripts/clean-build.mjs",
    "build": "tsc -b && npm run check:api && vite build",
    "build:clean": "npm run clean && npm run build",
    "check:booking-flow": "node scripts/booking-flow-smoke-check.mjs",
    "check:agreement-storage": "tsx --test scripts/rental-agreement-storage.test.mjs",
    "check:financial-logic": "tsx --test scripts/financial-logic.test.mjs",
    "check:reconciliation-logic": "tsx --test scripts/reconciliation-logic.test.mjs",
    "check:process-logic": "tsx --test scripts/process-logic.test.mjs",
    "check:kyc-ocr": "tsx --test scripts/kyc-ocr-logic.test.mjs",
    "check:api-boundaries": "node scripts/api-boundary-smoke-check.mjs",
    "check:local-env": "node scripts/check-local-env.mjs",
    "check:live-supabase": "node scripts/verify-live-supabase.mjs",
    "check:live-workflows": "node scripts/verify-live-workflows.mjs",
    "check:live-roles": "node scripts/verify-live-role-matrix.mjs",
    "check:live-booking-journey": "tsx scripts/verify-live-disposable-booking-journey.mjs",
    "check:paymongo-readonly": "node scripts/verify-paymongo-readonly.mjs",
    "repair:orphan-profiles": "node scripts/repair-orphan-profiles.mjs --apply",
    "check:browser": "node scripts/browser-smoke-check.mjs",
    "check:targeted-ui": "tsx scripts/targeted-authenticated-ui-check.mjs",
    "check:api": "tsc -p tsconfig.api.json",
    "check:alignment": "node scripts/repository-alignment-check.mjs",
    "check:all": "npm run lint && npm run check:api && npm run check:booking-flow && npm run check:agreement-storage && npm run check:financial-logic && npm run check:reconciliation-logic && npm run check:process-logic && npm run check:kyc-ocr && npm run check:api-boundaries && npm run check:alignment && npm run check:browser && npm run check:local-env",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"api/**/*.ts\" \"*.{js,ts}\"",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.71.2",
    "react-router": "8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
